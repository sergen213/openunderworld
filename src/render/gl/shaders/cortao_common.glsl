// OpenGL CORTAO glue (docs/RENDERING.md "Ambient occlusion"), shared by the GL CORTAO passes (GlRenderer cortaoSource):
// the depth pre-pass's view-space normal is octahedral-encoded in an RG16F target (ao_prepass fragment shader).
vec2 ouOctEncode(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.xy;
    if (n.z < 0.0) e = (1.0 - abs(n.yx)) * vec2(e.x >= 0.0 ? 1.0 : -1.0, e.y >= 0.0 ? 1.0 : -1.0);
    return e;
}
vec3 ouOctDecode(vec2 e) {
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}
