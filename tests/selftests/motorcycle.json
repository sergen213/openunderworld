{
  "version": 1,
  "name": "motorcycle",
  "chapter": "Core mechanics: motorcycle mount, accelerate, steer, hop, brake, dismount",
  "note": "l4_trailstart bike 5482 (tests/replays/bike_ride.txt, ou_vehicle_tests). The bike is a Jolt wheeled vehicle with tru.exe's engine record; speeds here are ours [I].",
  "level": "l4_trailstart",
  "spawn": [37981, -51758, 1463, -126.7],
  "steps": [
    {"step": "mount", "input": ["0.3 interact 1", "0.4 interact 0"], "duration": 3,
     "until": {"probe": "bike.phase", "eq": "ride"},
     "expect": [{"visits": ["idle", "vehicle"]},
                {"clips": ["motorcycle:motorcycle_mount_cycle"]},
                {"probe": "bike.uid", "eq": 5482},
                {"probe": "bike.mounts", "eq": 1},
                {"probe": "bike.wheels", "eq": 2}]},
    {"step": "accelerate", "input": ["0 forward 1"], "duration": 1.1,
     "expect": [{"probe": "bike.speed", "min": 1600, "max": 2300},
                {"probe": "bike.throttle", "eq": 1},
                {"probe": "bike.wheels", "over": "all", "min": 1},
                {"probe": "bike.airborne", "over": "all", "eq": false},
                {"probe": "step.horizontal", "min": 800}]},
    {"step": "steer_left", "input": ["0 forward 0.4", "0.6 right -0.6", "1.4 right 0"], "duration": 1.8,
     "expect": [{"clips": ["motorcycle:motorcycle_lean_left"]},
                {"probe": "bike.steer", "over": "max", "min": 8, "note": "the front wheel turned left (+)"},
                {"probe": "bike.yaw", "min": 0, "max": 60, "note": "from -37 before the curve"},
                {"probe": "bike.speed", "min": 2000}]},
    {"step": "hop", "input": ["0 forward 0.4", "0 jump 1", "0.1 jump 0"], "duration": 0.8,
     "expect": [{"clips": ["motorcycle:motorcycle_jump", "motorcycle:motorcycle_jump_inair", "motorcycle:motorcycle_jump_land"]},
                {"probe": "bike.airborne", "over": "any", "eq": true},
                {"probe": "bike.wheels", "over": "min", "eq": 0},
                {"probe": "bike.wheels", "min": 1, "note": "back on the ground"}]},
    {"step": "brake", "input": ["0 forward -1", "0.6 forward 0", "0.6 drop 1"], "duration": 3.5,
     "expect": [{"probe": "bike.speed", "near": 0, "tol": 25},
                {"probe": "bike.wheels", "eq": 2},
                {"probe": "player.clip", "eq": "motorcycle:motorcycle_idle_foot_down"},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "dismount", "input": ["0.1 interact 1", "0.2 interact 0"], "duration": 4,
     "until": {"probe": "player.state", "eq": "idle"},
     "expect": [{"clips": ["motorcycle:motorcycle_dismount_cycle", "ng_idle"]},
                {"probe": "bike.mounted", "eq": false},
                {"probe": "player.grounded", "eq": true}]}
  ]
}
