{
  "version": 1,
  "name": "grapple_swing",
  "chapter": "Core mechanics: grapple target, attach, jump into the gap with the rope, the driven swing, climb / slide on the rope with Interact, jump off, landing",
  "note": "l3_chapel: ceiling ring 4744 from the column top (GameReal.ChapelRingFromTheColumnTop). g_grapple data [O]: throw range and longest rope 4424.78, shortest 553.1. Rope inputs and the swing law are tru.exe's (docs/GAMEPLAY.md Grapple: 0x746F60, player data +0x9C8..+0xA54).",
  "level": "l3_chapel",
  "spawn": [-5126, 1900, -3141, 180],
  "steps": [
    {"step": "target_offered", "duration": 0.2,
     "expect": [{"probe": "grapple.offered", "eq": 4744},
                {"probe": "grapple.attached", "eq": false}]},
    {"step": "throw", "input": ["0 grapple 1", "0.1 grapple 0"], "duration": 3, "until": {"probe": "grapple.swinging", "eq": true},
     "expect": [{"visits": ["idle", "grapplethrow", "grappleswing"]},
                {"clips": ["grapple_rappel_free_jumpon", "grapple_rappel_idle"]},
                {"probe": "grapple.target", "eq": 4744},
                {"probe": "grapple.kind", "eq": "ceiling"},
                {"probe": "grapple.rope", "min": 553.1, "max": 4424.78},
                {"probe": "grapple.rope_max", "near": 4424.78, "tol": 0.01}]},
    {"step": "jump_into_gap", "input": ["0 forward 1", "0.2 jump 1", "0.3 jump 0", "1.2 forward 0"], "duration": 2.0,
     "expect": [{"probe": "grapple.attached", "over": "all", "eq": true, "note": "Jump while standing roped keeps the rope (chart T1407 / S752 -> S753 -> S380)"},
                {"clips": ["ng_walk", "grapple_rappel_free_jumpon"]},
                {"probe": "grapple.target", "eq": 4744},
                {"probe": "step.drop", "min": 100, "note": "hanging in the gap below the column top"},
                {"probe": "grapple.rope", "near": 3631.7, "tol": 5, "note": "the rope she hangs on: her distance when the jump came down (4208 from the column top)"}]},
    {"step": "no_stick", "duration": 3,
     "expect": [{"probe": "grapple.swinging", "over": "all", "eq": true},
                {"probe": "step.peak_height", "max": 200, "note": "without the stick the swing only dies down"}]},
    {"step": "forward_held", "input": ["0 forward 1"], "duration": 6,
     "expect": [{"probe": "grapple.swinging", "over": "all", "eq": true},
                {"clips": ["grapple_rappel_free_swing_forward"]},
                {"probe": "step.peak_height", "min": 1000, "note": "Forward held drives the swing higher every pass (tru.exe 0x746F60: the push follows her motion)"},
                {"probe": "step.peak_speed", "min": 4000},
                {"probe": "grapple.rope", "near": 3631.7, "tol": 5}]},
    {"step": "die_down", "duration": 6,
     "expect": [{"probe": "grapple.swinging", "over": "all", "eq": true},
                {"probe": "player.speed", "max": 300, "note": "let go of the stick: braked going outward (+0x9E0) and damped (+0x8DC)"}]},
    {"step": "stick_alone", "input": ["0 forward -1"], "duration": 0.3,
     "expect": [{"probe": "grapple.rope", "near": 3631.7, "tol": 1, "note": "without Interact the stick does not move the rope"}]},
    {"step": "climb_rope", "input": ["0 interact 1", "0 forward 1"], "duration": 1.0,
     "expect": [{"clips": ["grapple_rappel_free_ascend"]},
                {"probe": "grapple.rope", "near": 2920.6, "tol": 5, "note": "Interact + forward: 23.70 per 30 Hz frame = 711.1 units/s [O +0x9E4]"},
                {"probe": "step.height_gain", "near": 711.1, "tol": 8}]},
    {"step": "slide_rope", "input": ["0 interact 1", "0 forward -1"], "duration": 1.2,
     "expect": [{"clips": ["grapple_rappel_free_descend"]},
                {"probe": "grapple.rope", "near": 4399.7, "tol": 8, "note": "Interact + back: 41.09 per frame = 1232.6 units/s [O +0x9E8]"},
                {"probe": "step.drop", "min": 1300}]},
    {"step": "jump_off", "input": ["0.5 jump 1", "0.6 jump 0"], "duration": 5, "until": {"probe": "player.state", "eq": "land"},
     "expect": [{"visits": ["grappleswing", "jump", "land"]},
                {"clips": ["grapple_rappel_free_jumpoff", "ng_land_hard"], "note": "the leap off the long rope comes down more than 1264.22 (she loses health): the chart's hard landing (S1275 / S1276), not ng_generic_land_forwards"},
                {"probe": "grapple.attached", "eq": false},
                {"probe": "grapple.target", "eq": 0},
                {"probe": "step.peak_speed", "min": 1800, "note": "the leap off the rope: 63.21 per frame = 1896 units/s along her facing [O +0xA48]"},
                {"probe": "player.dead", "eq": false}]}
  ]
}
