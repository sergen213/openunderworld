{
  "version": 1,
  "name": "grapple_swing",
  "chapter": "Core mechanics: grapple target, attach, swing, climb / slide on the rope, jump off, landing",
  "note": "l3_chapel: ceiling ring 4744 from the column top (GameReal.ChapelRingFromTheColumnTop). g_grapple data [O]: throw range and longest rope 4424.78, shortest 553.1; the rope is climbed at 300 units/s [I]. The jump off is from ~1850 over the chapel floor: the landing costs fall damage.",
  "level": "l3_chapel",
  "spawn": [-5126, 1900, -3141, 180],
  "steps": [
    {"step": "target_offered", "duration": 0.2,
     "expect": [{"probe": "grapple.offered", "eq": 4744}, {"probe": "grapple.attached", "eq": false}]},
    {"step": "throw", "input": ["0 grapple 1", "0.1 grapple 0"], "duration": 3,
     "until": {"probe": "grapple.swinging", "eq": true},
     "expect": [{"visits": ["idle", "grapplethrow", "grappleswing"]},
                {"clips": ["grapple_rappel_free_jumpon", "grapple_rappel_idle"]},
                {"probe": "grapple.target", "eq": 4744},
                {"probe": "grapple.kind", "eq": "ceiling"},
                {"probe": "grapple.rope", "min": 553.1, "max": 4424.78},
                {"probe": "grapple.rope_max", "near": 4424.78, "tol": 0.01}]},
    {"step": "swing", "input": ["0 forward 1"], "duration": 4,
     "expect": [{"probe": "grapple.swinging", "eq": true},
                {"probe": "grapple.target", "eq": 4744},
                {"clips": ["grapple_rappel_free_swing_forward"]},
                {"probe": "player.pos.x", "over": "min", "max": -8697, "note": "out past the ring (x -8697)"},
                {"probe": "step.drop", "min": 1500, "note": "down through the pendulum's arc"},
                {"probe": "step.peak_speed", "min": 3000},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "climb_rope", "input": ["0 interact 1"], "duration": 1.5,
     "expect": [{"clips": ["grapple_rappel_free_ascend"]},
                {"probe": "grapple.rope", "near": 3758.3, "tol": 6, "note": "450 shorter after 1.5 s"},
                {"probe": "step.height_gain", "min": 300}]},
    {"step": "slide_rope", "input": ["0 walk 1"], "duration": 1.5,
     "expect": [{"clips": ["grapple_rappel_free_descend"]},
                {"probe": "grapple.rope", "near": 4208.3, "tol": 6},
                {"probe": "step.drop", "min": 300}]},
    {"step": "jump_off", "input": ["0 forward 1", "2.0 jump 1", "2.1 jump 0", "2.2 forward 0"], "duration": 4,
     "until": {"probe": "player.state", "eq": "land"},
     "expect": [{"visits": ["grappleswing", "jump", "land"]},
                {"clips": ["grapple_rappel_free_jumpoff", "ng_generic_land_forwards"]},
                {"probe": "grapple.attached", "eq": false},
                {"probe": "grapple.target", "eq": 0},
                {"probe": "player.pos.z", "near": -6968.4, "tol": 3, "note": "the chapel floor"},
                {"probe": "step.health_lost", "min": 500, "max": 900, "note": "a fall of 1817..2215 costs 500..1000"},
                {"probe": "player.dead", "eq": false}]}
  ]
}
