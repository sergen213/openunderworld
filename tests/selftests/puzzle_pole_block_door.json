{
  "version": 1,
  "name": "puzzle_pole_block_door",
  "chapter": "Southern Mexico (l4_ballcourt): pole into the pole lever, push block under it, hang on the pole, door 6505 opens",
  "walkthrough": "https://tombraiders.net/stella/walks/TR8walk/details/mexico2.html",
  "note": "The plan lines are those of tests/replays/ballcourt_pole_lever_block.txt (docs/GAMEPLAY.md Receptacle replays): pole 6503 into lever 6502 (anim graph 0 -> 1), push block 6504 along its two axes to under the pole, up onto the block, a standing jump to the pole; her weight slides the lever to -600 and door 6505 rises on its joint.",
  "level": "l4_ballcourt",
  "spawn": [-20300, 14700, 3484, -90],
  "steps": [
    {"step": "take_pole", "plan": ["engage 6503 walk", "press", "wait 3"], "duration": 40,
     "expect": [{"probe": "portable.held", "eq": 6503}, {"probe": "object.6502.graph", "eq": 0}]},
    {"step": "insert_pole", "plan": ["engage 6502 walk", "press", "wait 3"], "duration": 40,
     "expect": [{"probe": "portable.held", "eq": 0},
                {"probe": "portable.6503.in", "eq": 6502},
                {"probe": "object.6502.graph", "eq": 1},
                {"probe": "object.6502.joint", "near": 0, "tol": 1},
                {"probe": "object.6505.body.z", "near": 0, "tol": 5, "note": "the door is still shut"}]},
    {"step": "push_block_east", "plan": ["go -21950 14750 60", "go -22350 14650 60", "go -22260 14266 25 walk", "face 0", "push 1 0 15.7", "wait 0.5"],
     "duration": 80,
     "expect": [{"visits": ["block"]},
                {"clips": ["obj_block_grab", "obj_block_front", "obj_block_release"]},
                {"probe": "object.6504.pos.x", "near": -20261, "tol": 15},
                {"probe": "object.6504.pos.y", "near": 14907, "tol": 15}]},
    {"step": "push_block_south", "plan": ["go -20650 15250 40 walk", "go -20362 15169 20 walk", "face -69", "push 1 0 5.1", "wait 0.5"],
     "duration": 60,
     "expect": [{"visits": ["block"]},
                {"probe": "object.6504.pos.x", "near": -20078, "tol": 15, "note": "under the inserted pole"},
                {"probe": "object.6504.pos.y", "near": 14431, "tol": 15}]},
    {"step": "onto_the_block", "input": ["1.1 jump 1", "1.2 jump 0"], "duration": 4.6,
     "expect": [{"probe": "step.height_gain", "near": 410.8, "tol": 12, "note": "the block's ledge loop is 410.8 up [O model markup]"},
                {"probe": "player.grounded", "eq": true}]},
    {"step": "jump_to_the_pole", "input": ["0 jump 1", "0.1 jump 0"], "duration": 8,
     "expect": [{"probe": "player.state", "eq": "polehang"},
                {"probe": "object.6502.joint", "min": -601, "max": -350, "note": "the lever slides under her weight"},
                {"probe": "object.6505.body.z", "min": 700, "max": 1210, "note": "the door rises twice the lever's drop"}]}
  ]
}
