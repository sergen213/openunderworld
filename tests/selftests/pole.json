            "Hpole_perp_attach_M"
          ]
        },
        {
          "probe": "step.air_time",
          "near": 0.783,
          "tol": 0.05,
          "note": "23.5 / 30 s [O Wine]"
        },
        {
          "probe": "step.horizontal",
          "near": 1264,
          "tol": 8,
          "note": "pole to pole"
        },
        {
          "probe": "step.peak_height",
          "min": 100,
          "note": "a high arc (q33: 52.10 up a frame)"
