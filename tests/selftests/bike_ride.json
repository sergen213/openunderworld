{
  "version": 1,
  "name": "bike_ride",
  "chapter": "Southern Mexico: the first ride, from the bike on the trail over the tunnel's pit to the checkpoint beyond",
  "note": "l4_trailstart bike 5482. The autopilot's `ride` lines steer the bike with the raw stick as a player would (speed limits in units/s). The same plan is ridden by ou_vehicle_tests VehicleReal.FirstRideOverThePitByAutopilot; the original's ride of this route is traced in docs/GAMEPLAY.md \"Motorcycle\".",
  "level": "l4_trailstart",
  "spawn": [37981, -51758, 1463, -126.7],
  "steps": [
    {"step": "mount", "input": ["0.3 interact 1", "0.4 interact 0"], "duration": 3.5,
     "until": {"probe": "bike.phase", "eq": "ride"},
     "expect": [{"probe": "bike.uid", "eq": 5482},
                {"probe": "bike.wheels", "eq": 2}]},
    {"step": "trail", "duration": 25,
     "plan": ["ride 41000 -53900 400 1 3000",
              "ride 42800 -54000 300 1 2200",
              "ride 45000 -54000 400 1 2200",
              "ride 47500 -54100 400 1 2200",
              "ride 52000 -55300 600 1 3500",
              "ride 57500 -56100 500 1 3500",
              "ride 59500 -56150 300 1 2500",
              "ride 61000 -55900 400 1 2500"],
     "expect": [{"probe": "bike.mounted", "over": "all", "eq": true},
                {"probe": "bike.pos.x", "min": 60500, "note": "inside the stone tunnel"},
                {"probe": "bike.pos.z", "near": -690, "tol": 40, "note": "on the tunnel floor (-686)"},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "pit_jump", "duration": 6,
     "plan": ["ride 64000 -55680 300",
              "ride 66000 -55680 200",
              "ride 68500 -55700 500"],
     "expect": [{"probe": "bike.airborne", "over": "any", "eq": true, "note": "off the ramp's lip at x 66100"},
                {"probe": "bike.wheels", "over": "min", "eq": 0},
                {"probe": "bike.pos.x", "min": 67900, "note": "beyond the pit's far edge (x 67700)"},
                {"probe": "bike.pos.z", "min": -1200, "note": "not in the pit (floor -6680)"},
                {"probe": "bike.mounted", "eq": true},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "checkpoint", "duration": 6,
     "plan": ["ride 69586 -55062 500 1 1500"],
     "expect": [{"probe": "bike.mounted", "eq": true},
                {"probe": "bike.wheels", "min": 1},
                {"probe": "step.health_lost", "eq": 0}]}
  ]
}
