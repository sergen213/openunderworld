{
  "version": 1,
  "name": "landing",
  "chapter": "Core mechanics: landings by fall height, stick and Crouch",
  "note": "l4_temple, the floor west of block 1155 (z 1722.9). lara.drm's chart dispatches a landing (S1275) on: Crouch held + the stick forward -> ng_land_rolling at any height; a fall of 1264.22 or more -> ng_land_hard; 632.11 or more with the stick pushed -> ng_running_land_stumble; the stick at run level -> ng_running_land; else ng_generic_land_forwards (docs/GAMEPLAY.md \"Landings\"). The teleport fixtures only lift her.",
  "level": "l4_temple",
  "spawn": [-3000, -11850, 1730, 0],
  "steps": [
    {"step": "stand", "duration": 0.3,
     "expect": [{"probe": "player.pos.z", "near": 1722.9, "tol": 1.5}, {"probe": "player.state", "eq": "idle"}]},
    {"step": "low_no_stick", "fixtures": [{"teleport": [-3000, -11850, 2122.9, 0]}], "duration": 2.5,
     "expect": [{"visits": ["fall", "land", "idle"]}, {"clips": ["ng_generic_land_forwards", "ng_idle"]},
                {"probe": "step.drop", "near": 400, "tol": 3}]},
    {"step": "low_running_on", "fixtures": [{"teleport": [-3000, -11850, 2122.9, 0]}], "input": ["0 forward 1", "1.2 forward 0"], "duration": 2.5,
     "expect": [{"visits": ["fall", "run"]}, {"clips": ["ng_running_land", "ng_run"]},
                {"probe": "player.state", "eq": "idle"}]},
    {"step": "stumble", "fixtures": [{"teleport": [-3000, -11850, 2522.9, 0]}], "input": ["0 forward 1", "1.65 forward 0"], "duration": 3,
     "expect": [{"visits": ["fall", "run"]}, {"clips": ["ng_running_land_stumble", "ng_run"]},
                {"probe": "step.drop", "near": 800, "tol": 3},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "high_no_stick_is_plain", "fixtures": [{"teleport": [-3000, -11850, 2522.9, 0]}], "duration": 2.5,
     "expect": [{"clips": ["ng_generic_land_forwards", "ng_idle"]}]},
    {"step": "hard", "fixtures": [{"teleport": [-3000, -11850, 2992.9, 0]}], "input": ["0 forward 1"], "duration": 1.6,
     "expect": [{"visits": ["fall", "land"]}, {"clips": ["ng_land_hard"]},
                {"probe": "player.state", "eq": "land", "note": "1.1 s in place: the stick does not move her"},
                {"probe": "step.drop", "near": 1270, "tol": 3},
                {"probe": "step.health_lost", "eq": 0, "note": "damage starts at 1280.03"}]},
    {"step": "hard_ends", "duration": 1.2, "expect": [{"probe": "player.state", "eq": "idle"}]},
    {"step": "roll", "fixtures": [{"teleport": [-3000, -11850, 2722.9, 0]}], "input": ["0 forward 1", "0.2 drop 1", "1.0 drop 0", "1.4 forward 0"], "duration": 3,
     "expect": [{"visits": ["fall", "roll", "run"]}, {"clips": ["ng_land_rolling", "ng_run"]},
                {"probe": "step.drop", "near": 1000, "tol": 3}]},
    {"step": "jump_out_of_landing", "fixtures": [{"teleport": [-3000, -11850, 2122.9, 0]}], "input": ["0.48 jump 1", "0.6 jump 0"], "duration": 2.5,
     "expect": [{"visits": ["fall", "land", "jumpprep", "jump", "land", "idle"]}]}
  ]
}
