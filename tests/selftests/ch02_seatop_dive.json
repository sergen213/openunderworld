{
  "version": 1,
  "name": "ch02_seatop_dive",
  "chapter": "02 The Path to Avalon: from the boat down to the sea bed (docs/matrix/02_path_to_avalon.md C02-01, C02-02)",
  "walkthrough": "https://tombraiders.net/stella/walks/TR8walk/01avalon.html",
  "note": "Chapter 1 as chapter select starts it (the uplink cinematic skipped: its placement leaves her on the yacht's stern deck, checkpoint 1000). A running jump off the stern into the sea, up to the surface, Crouch dives, the look stick tips the view down and Forward + Sprint swims down on the wetsuit's tanks: no breath is lost; the stream changes to l1_seafloor on the way and she reaches the sea bed's depth (35000 under the deck). Not played: the swim on to the ruins and the eye door (ProgressionReal.EyeDoorSolvedByItsHandles plays the door with placed positions).",
  "start_chapter": 1,
  "steps": [
    {"step": "on_deck", "duration": 3,
     "expect": [{"probe": "player.state", "eq": "idle"},
                {"probe": "player.pos.z", "near": 2026, "tol": 5},
                {"probe": "world.unit", "eq": "l1_seatop"},
                {"probe": "world.checkpoint", "eq": 1000}]},
    {"step": "off_the_stern", "plan": ["run 0 4 jump 0.5"], "duration": 8, "until": {"probe": "player.swimming", "eq": true},
     "expect": [{"visits": ["run", "jumpprep", "jump", "swimsplash"]},
                {"probe": "water.in", "eq": true},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "come_up", "duration": 4, "until": {"probe": "player.state", "eq": "swimtread"},
     "expect": [{"visits": ["swimsplash", "surfacing", "swimtread"]},
                {"probe": "water.under", "eq": false}]},
    {"step": "dive", "input": ["0 drop 1", "0 looky -1", "1.1 looky 0"], "duration": 1.5,
     "expect": [{"visits": ["swimtread", "swimdive", "swimunder"]},
                {"probe": "water.under", "eq": true},
                {"probe": "camera.pitch", "max": -60, "note": "the view tipped down by the look stick"}]},
    {"step": "swim_down", "input": ["0 forward 1", "0 sprint 1"], "duration": 60, "until": {"probe": "world.unit", "eq": "l1_seafloor"},
     "expect": [{"probe": "player.state", "over": "all", "eq": "swimunder"},
                {"clips": ["swim_submerged_sprint"]},
                {"probe": "player.air", "over": "all", "eq": 1, "note": "scuba: the breath does not drain"}]},
    {"step": "to_the_sea_bed", "input": ["0 forward 1", "0 sprint 1", "0 looky -0.5"], "duration": 40, "until": {"probe": "player.pos.z", "max": -33000},
     "expect": [{"probe": "world.unit", "eq": "l1_seafloor"},
                {"probe": "player.air", "over": "all", "eq": 1},
                {"probe": "player.swimming", "eq": true},
                {"probe": "step.health_lost", "eq": 0}]}
  ]
}
