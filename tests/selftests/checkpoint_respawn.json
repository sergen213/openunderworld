{
  "version": 1,
  "name": "checkpoint_respawn",
  "chapter": "Core mechanics: a death restores the checkpoint save (weapons, rounds, grenades, the light, the clock)",
  "note": "l4_pool. tru.exe saves the whole game when a checkpoint is activated (message 0x196 -> Save Game 0x5570F0) and restores that save after the death wipe (0x6F55A0 -> Restore Game 0x557130). Lara lights her torch and walks onto checkpoint 5502; after it she fires the submachine guns, throws a grenade and puts the torch out; a 2600-unit fall kills her. She is back on the checkpoint with the rounds, the grenades and the torch of the moment she activated it, full health, hands empty, and the World's clock is the checkpoint's again.",
  "level": "l4_pool",
  "fixtures": [{"weapon": "uzi"}],
  "steps": [
    {"step": "light_on", "input": ["0.2 light 1", "0.3 light 0"], "duration": 0.6,
     "expect": [{"probe": "world.flashlight", "eq": true},
                {"probe": "weapon.secondary", "eq": "uzi"},
                {"probe": "weapon.uzi.reserve", "eq": 240, "note": "the level start's amount at the default AMMUNITION CAPACITY (Lara data +0x85C)"},
                {"probe": "weapon.uzi.clip", "eq": 80},
                {"probe": "weapon.grenades", "eq": 6},
                {"probe": "world.checkpoint", "eq": 0}]},
    {"step": "touch_checkpoint", "plan": ["go -15550 -288 60"], "duration": 10,
     "expect": [{"probe": "world.checkpoint", "eq": 5502}, {"probe": "world.checkpoint_unit", "eq": "l4_pool"}]},
    {"step": "walk_away", "plan": ["go -14885 -43 60"], "duration": 10,
     "expect": [{"probe": "world.checkpoint", "eq": 5502}, {"probe": "step.horizontal", "min": 500}]},
    {"step": "spend", "input": ["0 weapon 1", "0.1 weapon 0", "0.3 draw 1", "0.4 draw 0", "1.5 fire 1", "3.5 fire 0", "4 grenade 1", "4.1 grenade 0",
                                "6 light 1", "6.1 light 0"], "duration": 7,
     "expect": [{"probe": "weapon.current", "eq": "uzi"},
                {"probe": "weapon.shots_fired", "min": 10},
                {"probe": "weapon.uzi.clip", "max": 70},
                {"probe": "weapon.grenades", "eq": 5},
                {"probe": "world.flashlight", "eq": false},
                {"probe": "world.checkpoint", "eq": 5502}]},
    {"step": "fatal_fall", "fixtures": [{"teleport": [-14885.4, -42.6, 7321.2, 0]}], "duration": 5,
     "until": {"probe": "player.state", "eq": "dead"},
     "expect": [{"probe": "player.health", "max": 0},
                {"probe": "weapon.grenades", "eq": 5}]},
    {"step": "respawn", "duration": 8,
     "until": {"probe": "player.state", "eq": "idle"},
     "expect": [{"probe": "step.teleports", "eq": 1},
                {"probe": "step.seconds", "near": 3.0, "tol": 0.3, "note": "the death wipe: 90 frames (DeathState 0x75AA50 / 0x75AF90)"},
                {"probe": "player.health", "eq": 1000},
                {"probe": "player.pos.x", "near": -15550, "tol": 5},
                {"probe": "player.pos.y", "near": -288, "tol": 5},
                {"probe": "player.pos.z", "near": 4721.2, "tol": 2},
                {"probe": "world.checkpoint", "eq": 5502},
                {"probe": "weapon.uzi.clip", "eq": 80, "note": "the rounds fired after the checkpoint are back"},
                {"probe": "weapon.uzi.reserve", "eq": 240},
                {"probe": "weapon.grenades", "eq": 6},
                {"probe": "world.flashlight", "eq": true},
                {"probe": "weapon.drawn", "eq": false},
                {"probe": "weapon.current", "eq": "pistols"},
                {"probe": "weapon.secondary", "eq": "uzi"},
                {"probe": "world.ticks", "max": 1300, "note": "the clock is the checkpoint save's (the run itself is past 1800 ticks by now)"}]}
  ]
}
