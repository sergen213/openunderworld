{
  "version": 1,
  "name": "slide",
  "chapter": "Core mechanics: slope slide (stand / slide by face flag and angle)",
  "walkthrough": "https://tombraiders.net/stella/walks/TR8walk/details/niflheim.html",
  "note": "l1_kraken_room, the ramp into the lower hall (C03-09). Its faces carry collision client flag 0x0004: the flat top (normal z 1.0) is stood on, the 44.6-degree face (normal z 0.712, y -620..-2400) is a slope slide (tru.exe 0x5DCE20: slide-flagged faces between 28 and 52 degrees), the run-out (normal z 0.919 / 0.953, flatter than 28 degrees) is stood on again. Slide speed: 35..45 units per 30 Hz frame over 29..51 degrees = 42.09 per frame = 1262.7 units/s here (docs/GAMEPLAY.md \"Slopes and slides\").",
  "level": "l1_kraken_room",
  "spawn": [-9026.4, -208, 2060, -90],
  "fixtures": [{"health": 1000}],
  "steps": [
    {"step": "stands_on_flagged_flat", "duration": 1,
     "expect": [{"probe": "player.state", "eq": "idle", "over": "all"},
                {"probe": "player.pos.z", "near": 2054.7, "tol": 1.5}]},
    {"step": "run_onto_slide", "input": ["0 forward 1", "0.6 forward 0"], "duration": 3,
     "until": {"probe": "player.state", "eq": "slide"},
     "expect": [{"probe": "player.pos.y", "min": -760}, {"probe": "player.pos.y", "max": -560}]},
    {"step": "slides_down", "duration": 5,
     "until": {"probe": "player.state", "ne": "slide"},
     "expect": [{"clips": ["slope_transitionto", "slope_slidefront"]},
                {"probe": "player.speed", "over": "max", "near": 899.0, "tol": 6, "note": "1262.7 along the slope x normal z 0.712"},
                {"probe": "player.vspeed", "over": "min", "near": -886.7, "tol": 8},
                {"probe": "player.pos.y", "max": -2360}, {"probe": "player.pos.y", "min": -2520},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "stumbles_off_and_stands", "duration": 4,
     "until": {"probe": "player.state", "eq": "idle"},
     "expect": [{"clips": ["slope_slide_stumble_off", "ng_idle"]},
                {"probe": "player.grounded", "eq": true, "over": "all"},
                {"probe": "step.health_lost", "eq": 0}]},
    {"step": "cannot_run_back_up", "input": ["0 forward -1", "2.5 forward 0"], "duration": 6,
     "expect": [{"visits": ["run", "slide"]},
                {"probe": "player.pos.z", "over": "max", "max": 420, "note": "the slide face starts at z 300"},
                {"probe": "player.grounded", "eq": true},
                {"probe": "step.health_lost", "eq": 0}]}
  ]
}
