{
  "version": 1,
  "name": "ledge",
  "chapter": "Core mechanics: ledge grab from a standing jump, shimmy both ways, pull up",
  "note": "l3_main_bedroom ledge 973 (the prologue wall; tru.exe catches it from a standing jump there, GameReal.HangLeapsMatchTruTraces). The spawn stands in a fire trigger of the burning manor: 300 health goes on the first tick.",
  "level": "l3_main_bedroom",
  "spawn": [-8484.3, -4330, 244, -90],
  "steps": [
    {"step": "jump_and_grab", "input": ["0.1 jump 1", "0.2 jump 0"], "duration": 3,
     "until": {"probe": "player.clip", "eq": "ledgeb_idle"},
     "expect": [{"visits": ["idle", "jumpprep", "jump", "hang"]},
                {"clips": ["ng_standing_jump", "ledgeb_attach_M", "ledgeb_idle"]},
                {"probe": "player.ledge", "eq": 973},
                {"probe": "player.hanging", "eq": true},
                {"probe": "player.saving_grab", "eq": 0, "note": "a firm two-handed hang"}]},
    {"step": "shimmy_left", "input": ["0 right -1"], "duration": 1.5,
     "expect": [{"probe": "player.state", "eq": "shimmy"},
                {"probe": "player.ledge", "eq": 973},
                {"probe": "step.horizontal", "min": 380, "max": 500, "note": "ledgeb_right mirrored, ~290 units/s"},
                {"probe": "step.peak_height", "max": 8},
                {"probe": "step.drop", "max": 8}]},
    {"step": "shimmy_right", "input": ["0 right 1"], "duration": 1.0,
     "expect": [{"probe": "player.state", "over": "any", "eq": "shimmy"},
                {"probe": "player.ledge", "eq": 973},
                {"probe": "step.horizontal", "min": 100}]},
    {"step": "hang_still", "duration": 0.8,
     "expect": [{"probe": "player.state", "eq": "hang"}, {"probe": "player.clip", "eq": "ledgeb_idle"}, {"probe": "player.speed", "eq": 0}]},
    {"step": "pull_up", "input": ["0 forward 1", "0.1 jump 1", "0.2 jump 0", "0.5 forward 0"], "duration": 4,
     "until": {"probe": "player.state", "eq": "idle"},
     "expect": [{"visits": ["hang", "climbup", "idle"]},
                {"clips": ["ledgeb_climbup_fast", "ng_idle"]},
                {"probe": "step.height_gain", "near": 496, "tol": 6, "note": "the hang's hands 495.6 over her root (AnimLibrary::hangHandOffset)"},
                {"probe": "player.ledge", "eq": -1},
                {"probe": "player.grounded", "eq": true}]}
  ]
}
