{
 "version": 1,
 "name": "adrenaline",
 "chapter": "Combat: adrenaline - the meter fills by damage and latches, head shot on Grapple, focused fire on Manual Aim",
 "note": "l4_pool start, a target dummy 900 ahead (inside the close lock tier). [O] 0x6F28C0 / 0x6E6630 latch, chart T1404 head shot (flag 0x400000), 0x718BD0 focused fire, on the global time scale (window 0.2, mode 0.5).",
 "level": "l4_pool",
 "fixtures": [{"target": {"pos": [-13985, -42, 4721], "health": 20000}}],
 "steps": [
  {"step": "fill_the_meter", "input": ["0.3 aim 1", "0.3 fire 1"], "duration": 25,
   "until": {"probe": "player.adrenaline", "eq": 1},
   "expect": [{"probe": "combat.locked", "eq": true},
              {"probe": "combat.headshot_ready", "eq": true, "note": "full = latched"},
              {"probe": "target.0.hits", "min": 12, "note": "500 damage dealt fills it"},
              {"probe": "combat.time_scale", "over": "all", "eq": 1}]},
  {"step": "latched_meter_stays", "input": ["0 aim 1"], "duration": 3,
   "expect": [{"probe": "player.adrenaline", "over": "all", "eq": 1},
              {"probe": "combat.headshot", "over": "all", "eq": false}]},
  {"step": "head_shot_starts", "input": ["0 aim 1", "0.1 grapple 1", "0.2 grapple 0"], "duration": 4,
   "until": {"probe": "combat.headshot_window", "eq": true},
   "expect": [{"probe": "combat.headshot", "eq": true},
              {"probe": "player.adrenaline", "eq": 0, "note": "the move spends the meter"},
              {"probe": "combat.headshot_ready", "eq": false},
              {"probe": "grapple.attached", "over": "all", "eq": false, "note": "no rope: the button starts the paired move"}]},
  {"step": "window_slows_time", "input": ["0 aim 1"], "duration": 0.5,
   "expect": [{"probe": "combat.time_scale", "over": "min", "near": 0.2, "tol": 0.01},
              {"probe": "combat.headshot_window", "eq": true}]},
  {"step": "window_closes", "input": ["0 aim 1"], "duration": 10,
   "until": [{"probe": "combat.headshot", "eq": false}, {"probe": "combat.time_scale", "eq": 1}],
   "expect": [{"probe": "combat.headshot_window", "eq": false},
              {"probe": "player.state", "eq": "idle"}]},
  {"step": "fill_again", "input": ["0 aim 1", "0 fire 1"], "duration": 25,
   "until": {"probe": "player.adrenaline", "eq": 1},
   "expect": [{"probe": "combat.headshot_ready", "eq": true}]},
  {"step": "focused_fire", "input": ["0 aim 1", "0 fire 1", "0.1 manual 1", "0.2 manual 0"], "duration": 1.5,
   "expect": [{"probe": "combat.adrenaline_mode", "eq": true},
              {"probe": "combat.manual_aim", "over": "all", "eq": false, "note": "with the lock held the button is focused fire, not the aim view"},
              {"probe": "combat.time_scale", "near": 0.5, "tol": 0.01, "note": "the mode's scale (the head-shot window's is 0.2)"},
              {"probe": "combat.headshot_ready", "eq": false, "note": "starting the mode clears the latch"},
              {"probe": "player.adrenaline", "max": 0.99, "note": "the mode drains the meter"},
              {"probe": "combat.locked", "eq": true}]},
  {"step": "mode_runs_out", "input": ["0 aim 1", "0 fire 1"], "duration": 40,
   "until": [{"probe": "combat.adrenaline_mode", "eq": false}, {"probe": "combat.time_scale", "eq": 1}],
   "expect": [{"probe": "player.adrenaline", "max": 0.3},
              {"probe": "player.dead", "eq": false}]}
 ]
}
