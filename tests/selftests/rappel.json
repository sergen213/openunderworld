{
  "version": 1,
  "name": "rappel",
  "chapter": "Core mechanics: wall grapple, rappel down and up with Interact held, leap off the wall",
  "note": "l1_kraken_room wall anchor 326 (tests/replays/kraken_rappel.txt, GameReal.KrakenRoomRappel).",
  "level": "l1_kraken_room",
  "spawn": [-2204, -15106, 2212, 180],
  "steps": [
    {"step": "throw_and_swing_onto_wall", "input": ["0.2 grapple 1", "0.3 grapple 0", "0.3 right 1"], "duration": 3.5,
     "until": {"probe": "grapple.rappel", "eq": true},
     "expect": [{"visits": ["idle", "grapplethrow", "grappleswing", "grapplerappel"]},
                {"clips": ["grapple_rappel_free_jumpon", "ng_walk", "grapple_rappel_free_swing_forward", "grapple_rappel_wall_land_left"]},
                {"probe": "grapple.target", "eq": 326},
                {"probe": "grapple.kind", "eq": "wall"},
                {"probe": "grapple.on_wall", "eq": true}]},
    {"step": "settle", "duration": 0.5,
     "expect": [{"probe": "grapple.rappel", "eq": true}, {"probe": "grapple.rope", "near": 1085.1, "tol": 10}]},
    {"step": "stick_alone", "input": ["0 forward -1"], "duration": 0.5,
     "expect": [{"probe": "grapple.rappel", "over": "all", "eq": true},
                {"probe": "grapple.rope", "near": 1085.4, "tol": 10, "note": "without Interact the stick does not move the rope (tru.exe 0x745FA0)"}]},
    {"step": "rappel_down", "input": ["0 interact 1", "0 forward -1"], "duration": 0.4,
     "expect": [{"clips": ["grapple_rappel_down"]},
                {"probe": "grapple.rappel", "over": "all", "eq": true},
                {"probe": "grapple.rope", "near": 1616.4, "tol": 30, "note": "Interact + back: 44.25 units per 30 Hz frame = 1327.4 units/s [O +0x928]"},
                {"probe": "step.drop", "min": 250, "max": 600}]},
    {"step": "rappel_up", "input": ["0 interact 1", "0 forward 1"], "duration": 0.6,
     "expect": [{"clips": ["grapple_rappel_up"]},
                {"probe": "grapple.rappel", "over": "all", "eq": true},
                {"probe": "grapple.rope", "near": 990.6, "tol": 30, "note": "Interact + forward: 34.77 per frame = 1043 units/s [O +0x924]"},
                {"probe": "step.height_gain", "min": 250, "max": 700}]},
    {"step": "leap_off", "input": ["0.5 jump 1", "0.6 jump 0"], "duration": 1.2,
     "expect": [{"visits": ["grapplerappel", "jump"]},
                {"clips": ["grapple_rappel_jumpoff_back"]},
                {"probe": "grapple.attached", "eq": false, "note": "Jump leaps back off the wall and lets the rope go (chart S320 -> S326)"},
                {"probe": "grapple.target", "eq": 0},
                {"probe": "step.peak_speed", "min": 1500, "note": "53.73 per frame = 1611.9 units/s out [O +0x9A4]"}]}
  ]
}
