{
  "version": 1,
  "name": "rappel",
  "chapter": "Core mechanics: wall grapple, rappel down and up, kick off the wall",
  "note": "l1_kraken_room wall anchor 326 (tests/replays/kraken_rappel.txt, GameReal.KrakenRoomRappel).",
  "level": "l1_kraken_room",
  "spawn": [-2204, -15106, 2212, 180],
  "steps": [
    {"step": "throw_and_swing_onto_wall", "input": ["0.2 grapple 1", "0.3 grapple 0", "0.3 right 1"], "duration": 3.5,
     "until": {"probe": "grapple.rappel", "eq": true},
     "expect": [{"visits": ["idle", "grapplethrow", "grappleswing", "grapplerappel"]},
                {"clips": ["grapple_rappel_free_jumpon", "grapple_rappel_free_swing_forward", "grapple_rappel_wall_land"]},
                {"probe": "grapple.target", "eq": 326},
                {"probe": "grapple.kind", "eq": "wall"},
                {"probe": "grapple.on_wall", "eq": true}]},
    {"step": "settle", "duration": 0.5,
     "expect": [{"probe": "grapple.rappel", "eq": true}, {"probe": "grapple.rope", "near": 1095.2, "tol": 10}]},
    {"step": "rappel_down", "input": ["0 forward -1"], "duration": 1.5,
     "expect": [{"clips": ["grapple_rappel_down"]},
                {"probe": "grapple.rappel", "over": "all", "eq": true},
                {"probe": "grapple.rope", "near": 1544.6, "tol": 15, "note": "the rope pays out 300 units/s"},
                {"probe": "step.drop", "min": 400, "max": 520}]},
    {"step": "rappel_up", "input": ["0 forward 1"], "duration": 2,
     "expect": [{"clips": ["grapple_rappel_up"]},
                {"probe": "grapple.rappel", "over": "all", "eq": true},
                {"probe": "grapple.rope", "near": 944.7, "tol": 15},
                {"probe": "step.height_gain", "min": 540, "max": 660}]},
    {"step": "kick_off", "input": ["0.5 jump 1", "0.6 jump 0"], "duration": 2,
     "expect": [{"visits": ["grapplerappel", "grappleswing", "grapplerappel"]},
                {"clips": ["grapple_rappel_free_swing_forward", "grapple_rappel_wall_land"]},
                {"probe": "grapple.target", "eq": 326},
                {"probe": "step.peak_speed", "min": 400}]}
  ]
}
