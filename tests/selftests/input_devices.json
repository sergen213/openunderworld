{
  "version": 1,
  "name": "input_devices",
  "chapter": "Core mechanics: keyboard and gamepad through SDL events and the default bindings",
  "note": "Every step sends SDL device events (step `events`), not Actions: ou-game handles them as live ones (platform::DeviceState, the bindings of config::InputConfig, readDevices). Default bindings (no --config): Space jump, Left Ctrl drop, pad A jump, pad left stick move, pad left trigger target lock, pad right stick look [tru.exe 0x487710 defaults, docs/GAMEPLAY.md Controls]. Pad 1 is a scenario pad (padadd), no real device.",
  "level": "l3_main_bedroom",
  "spawn": [-8484.3, -4330, 244, -90],
  "fixtures": [{"health": 1000}],
  "steps": [
    {"step": "keyboard_jump_and_grab",
     "events": ["0.1 key 44 1", "0.2 key 44 0"],
     "duration": 3,
     "until": {"probe": "player.clip", "eq": "ledgeb_idle"},
     "expect": [{"visits": ["idle", "jumpprep", "jump", "hang"]},
                {"probe": "player.ledge", "eq": 973}]},
    {"step": "keyboard_drop",
     "events": ["0.1 key 224 1", "0.2 key 224 0"],
     "duration": 3,
     "until": {"probe": "player.grounded", "eq": true},
     "expect": [{"probe": "player.hanging", "eq": false},
                {"probe": "step.drop", "min": 50}]},
    {"step": "pad_stick_runs_back",
     "events": ["0 padadd 1", "0.1 axis 1 1 32767"],
     "duration": 1.5,
     "expect": [{"probe": "player.state", "eq": "run"},
                {"probe": "player.speed", "min": 1000},
                {"probe": "step.horizontal", "min": 800}]},
    {"step": "pad_a_jumps",
     "note": "the step's start released the stick (its axis back to 0): she stops, then A",
     "events": ["0.6 button 1 0 1", "0.7 button 1 0 0"],
     "duration": 3,
     "until": [{"probe": "step.peak_height", "min": 100}, {"probe": "player.state", "eq": "idle"}],
     "expect": [{"visits": ["idle", "jumpprep", "jump", "land", "idle"]},
                {"probe": "step.peak_height", "near": 201.6, "tol": 3, "note": "the standing jump of locomotion"}]},
    {"step": "pad_trigger_locks",
     "events": ["0.1 axis 1 4 32767"],
     "duration": 1.5,
     "expect": [{"probe": "weapon.drawn", "eq": true},
                {"probe": "hud.reticle", "eq": "free", "note": "nobody to lock: the free-aim reticle"},
                {"probe": "camera.yaw", "near": -80.1, "tol": 3, "note": "where the run left the camera"}]},
    {"step": "pad_right_stick_looks",
     "events": ["0.1 axis 1 2 32767", "0.6 axis 1 2 0"],
     "duration": 1,
     "expect": [{"probe": "camera.yaw", "near": -151.8, "tol": 3, "note": "0.5 s at full deflection x 2.5 rad/s (game/Input.cpp kPadLookRate) = 71.6 degrees to the right from -80.1"},
                {"probe": "player.state", "eq": "idle"}]}
  ]
}
